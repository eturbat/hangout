# Copy this file to .env (which git ignores) and fill it in.

# shell.nix runs Postgres on localhost with no password.
# Replace YOUR_USERNAME with the output of `whoami`.
DATABASE_URL=postgres://turbqt@localhost:5432/hangout

# Signs edit tokens. Any long random string; generate one with:
#   openssl rand -base64 32
# Changing it signs everyone out of their saved names.
EDIT_TOKEN_SECRET=

PORT=3000

# Only needed once the frontend is served from a different origin.
# CORS_ORIGIN=https://your-frontend.example
