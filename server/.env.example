# Copy this file to .env (git ignores .env) and fill it in.

# shell.nix runs Postgres on localhost with no password.
# Replace YOUR_USERNAME with the output of `whoami`.
DATABASE_URL=postgres://YOUR_USERNAME@localhost:5432/hangout

PORT=3000

# Only needed once the frontend is served from a different address.
# Separate several with commas.
# CORS_ORIGIN=https://your-frontend.example

# Tables are created automatically from the entity classes.
# Set this once the deployed database holds data you care about.
# DB_SYNCHRONIZE=false
